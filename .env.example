# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys — this repo is public.

# --- Supabase ---
# https://supabase.com/dashboard → your project → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by API routes for elevated DB writes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk ---
# https://dashboard.clerk.com → API keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk JWT template name configured for Supabase RLS (see docs/setup.md)
CLERK_JWT_TEMPLATE_NAME=supabase

# --- Gemini (Google AI Studio) ---
# https://aistudio.google.com/app/apikey
# Free tier: 1500 req/day on gemini-2.0-flash. Server-only.
GEMINI_API_KEY=

# --- Fallback vision provider (optional) ---
# OpenRouter key for Qwen2.5-VL fallback if Gemini rate-limits.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- FX rates ---
# frankfurter.app requires no key. Listed here for documentation only.
FX_API_BASE=https://api.frankfurter.app
